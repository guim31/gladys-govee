{
  "manifest_version": 1,
  "type": "device",
  "name": "Govee",
  "description": {
    "en": "Govee bulbs, light strips and lamps over the local network (LAN API), cloud API optional.",
    "fr": "Ampoules, rubans LED et lampes Govee en réseau local (API LAN), API cloud en option.",
    "de": "Govee-Lampen, LED-Streifen und Leuchten im lokalen Netzwerk (LAN-API), Cloud-API optional.",
    "es": "Bombillas, tiras LED y lámparas Govee en la red local (API LAN), API en la nube opcional."
  },
  "version": "1.0.2",
  "docker_image": "ghcr.io/guim31/gladys-govee:1.0.2",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-govee/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local", "cloud"],
  "network_discovery": [
    {
      "type": "udp-broadcast",
      "ports": [4002]
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Local control (LAN)",
        "fr": "Contrôle local (LAN)",
        "de": "Lokale Steuerung (LAN)",
        "es": "Control local (LAN)"
      },
      "description": {
        "en": "In the Govee Home app, open each light, tap the gear icon and turn on \"LAN Control\". Then enter the IP addresses of your lights below (find them in your router), or a range to scan.",
        "fr": "Dans l'application Govee Home, ouvrez chaque lampe, touchez la roue dentée et activez « LAN Control ». Saisissez ensuite les adresses IP de vos lampes ci-dessous (votre box les affiche), ou une plage à parcourir.",
        "de": "Öffne in der Govee-Home-App jede Lampe, tippe auf das Zahnrad und aktiviere „LAN Control“. Gib dann unten die IP-Adressen deiner Lampen ein (du findest sie in deinem Router) oder einen zu durchsuchenden Bereich.",
        "es": "En la aplicación Govee Home, abra cada luz, toque el icono del engranaje y active «LAN Control». Después introduzca abajo las direcciones IP de sus luces (las encontrará en su router), o un rango que explorar."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-govee/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "lan_addresses",
      "type": "string",
      "label": {
        "en": "Light IP addresses or ranges",
        "fr": "Adresses IP ou plages des lampes",
        "de": "IP-Adressen oder Bereiche der Lampen",
        "es": "Direcciones IP o rangos de las luces"
      },
      "description": {
        "en": "Separated by commas. One address (192.168.1.42), a range (192.168.1.20-60) or a whole network (192.168.1.0/24), 1024 addresses at most.",
        "fr": "Séparées par des virgules. Une adresse (192.168.1.42), une plage (192.168.1.20-60) ou un réseau entier (192.168.1.0/24), 1024 adresses au plus.",
        "de": "Durch Kommas getrennt. Eine Adresse (192.168.1.42), ein Bereich (192.168.1.20-60) oder ein ganzes Netzwerk (192.168.1.0/24), höchstens 1024 Adressen.",
        "es": "Separadas por comas. Una dirección (192.168.1.42), un rango (192.168.1.20-60) o una red completa (192.168.1.0/24), 1024 direcciones como máximo."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.42, 192.168.1.0/24",
        "fr": "ex. 192.168.1.42, 192.168.1.0/24",
        "de": "z. B. 192.168.1.42, 192.168.1.0/24",
        "es": "p. ej. 192.168.1.42, 192.168.1.0/24"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "lan_poll_interval",
      "type": "select",
      "label": {
        "en": "Light state refresh",
        "fr": "Rafraîchissement de l'état des lampes",
        "de": "Aktualisierung des Lampenstatus",
        "es": "Actualización del estado de las luces"
      },
      "description": {
        "en": "How often the lights are asked for their state (changes made in the Govee app or with a remote). Gladys commands are confirmed right away.",
        "fr": "Fréquence à laquelle les lampes sont interrogées (changements faits depuis l'application Govee ou une télécommande). Les commandes Gladys sont confirmées aussitôt.",
        "de": "Wie oft die Lampen nach ihrem Status gefragt werden (Änderungen in der Govee-App oder mit einer Fernbedienung). Befehle aus Gladys werden sofort bestätigt.",
        "es": "Frecuencia con la que se consulta el estado de las luces (cambios hechos en la aplicación Govee o con un mando a distancia). Los comandos de Gladys se confirman de inmediato."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "Every 10 seconds",
            "fr": "Toutes les 10 secondes",
            "de": "Alle 10 Sekunden",
            "es": "Cada 10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 seconds",
            "fr": "Toutes les 30 secondes",
            "de": "Alle 30 Sekunden",
            "es": "Cada 30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every minute",
            "fr": "Toutes les minutes",
            "de": "Jede Minute",
            "es": "Cada minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "Every 2 minutes",
            "fr": "Toutes les 2 minutes",
            "de": "Alle 2 Minuten",
            "es": "Cada 2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de las funciones"
      },
      "description": {
        "en": "Names given to the features of new devices (Light, Brightness...).",
        "fr": "Noms donnés aux fonctionnalités des nouveaux appareils (Éclairage, Luminosité…).",
        "de": "Namen der Funktionen neuer Geräte (Licht, Helligkeit …).",
        "es": "Nombres dados a las funciones de los nuevos dispositivos (Luz, Brillo...)."
      },
      "required": false,
      "default": "en",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "cloud",
      "type": "section",
      "label": {
        "en": "Govee cloud API (optional)",
        "fr": "API cloud Govee (facultative)",
        "de": "Govee-Cloud-API (optional)",
        "es": "API en la nube de Govee (opcional)"
      },
      "description": {
        "en": "Without a key the integration stays 100% local. With one, Gladys also reaches the devices without LAN control (plugs, thermometers, humidifiers...) and falls back to the cloud when a light does not answer locally. Get a free key in the Govee Home app: Profile, Settings, Apply for API Key. Govee allows 10,000 requests a day.",
        "fr": "Sans clé, l'intégration reste 100 % locale. Avec une clé, Gladys atteint aussi les appareils sans contrôle LAN (prises, thermomètres, humidificateurs…) et passe par le cloud quand une lampe ne répond pas en local. Clé gratuite dans l'application Govee Home : Profil, Réglages, Apply for API Key. Govee autorise 10 000 requêtes par jour.",
        "de": "Ohne Schlüssel bleibt die Integration zu 100 % lokal. Mit einem Schlüssel erreicht Gladys auch die Geräte ohne LAN-Steuerung (Steckdosen, Thermometer, Luftbefeuchter …) und weicht auf die Cloud aus, wenn eine Lampe lokal nicht antwortet. Einen kostenlosen Schlüssel bekommst du in der Govee-Home-App: Profil, Einstellungen, Apply for API Key. Govee erlaubt 10.000 Anfragen pro Tag.",
        "es": "Sin clave, la integración sigue siendo 100 % local. Con una clave, Gladys también accede a los dispositivos sin control LAN (enchufes, termómetros, humidificadores...) y recurre a la nube cuando una luz no responde en local. Obtenga una clave gratuita en la aplicación Govee Home: Perfil, Ajustes, Apply for API Key. Govee permite 10.000 solicitudes al día."
      },
      "links": [
        {
          "url": "https://developer.govee.com/",
          "label": {
            "en": "Govee developer platform",
            "fr": "Plateforme développeur Govee",
            "de": "Govee-Entwicklerplattform",
            "es": "Plataforma para desarrolladores de Govee"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "Govee API key",
        "fr": "Clé d'API Govee",
        "de": "Govee-API-Schlüssel",
        "es": "Clave de API de Govee"
      },
      "required": false
    },
    {
      "key": "cloud_poll_interval",
      "type": "select",
      "label": {
        "en": "Cloud state refresh",
        "fr": "Rafraîchissement par le cloud",
        "de": "Aktualisierung über die Cloud",
        "es": "Actualización a través de la nube"
      },
      "description": {
        "en": "For the devices reached through the cloud. Stretched automatically when needed to stay within the daily quota.",
        "fr": "Pour les appareils joints par le cloud. Allongé automatiquement si besoin pour rester dans le quota quotidien.",
        "de": "Für die über die Cloud erreichten Geräte. Wird bei Bedarf automatisch verlängert, um im Tageskontingent zu bleiben.",
        "es": "Para los dispositivos accesibles a través de la nube. Se alarga automáticamente si es necesario para no superar la cuota diaria."
      },
      "required": false,
      "default": "10",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes",
            "de": "Alle 15 Minuten",
            "es": "Cada 15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "Every hour",
            "fr": "Toutes les heures",
            "de": "Jede Stunde",
            "es": "Cada hora"
          }
        }
      ]
    }
